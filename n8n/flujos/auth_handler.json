{
  "name": "Iris Auth Handler v2.2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auth-trigger",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [200, 300],
      "id": "webhook-trigger-jid",
      "name": "WhatsApp Trigger (Evolution)"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "jid-assign",
              "name": "jid",
              "value": "={{ $json.body.data.key.remoteJid }}",
              "type": "string"
            },
            {
              "id": "auth-url-assign",
              "name": "auth_url",
              "value": "=https://accounts.google.com/o/oauth2/v2/auth?client_id={{ $env.PUBLIC_GOOGLE_CLIENT_ID }}&response_type=code&scope=openid%20email%20profile&redirect_uri={{ $env.PUBLIC_API_BASE_URL }}/auth/callback&state={{ $json.body.data.key.remoteJid }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [400, 300],
      "id": "set-auth-params",
      "name": "Prepare Auth Link"
    },
    {
      "parameters": {
        "resource": "messages-api",
        "instanceName": "iris",
        "remoteJid": "={{ $json.jid }}",
        "messageText": "¡Hola! Para empezar, vincula tu cuenta de la universidad aquí: {{ $json.auth_url }}",
        "options_message": {}
      },
      "type": "CUSTOM.evolutionApi",
      "typeVersion": 1,
      "position": [600, 300],
      "id": "send-auth-link",
      "name": "Send WA Auth Link"
    },
    {
      "parameters": {
        "path": "auth/callback",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [200, 500],
      "id": "oauth-callback",
      "name": "OAuth Callback"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "code",
              "value": "={{ $json.query.code }}"
            },
            {
              "name": "client_id",
              "value": "={{ $env.PUBLIC_GOOGLE_CLIENT_ID }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $env.GOOGLE_CLIENT_SECRET }}"
            },
            {
              "name": "redirect_uri",
              "value": "={{ $env.PUBLIC_API_BASE_URL }}/auth/callback"
            },
            {
              "name": "grant_type",
              "value": "authorization_code"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 500],
      "id": "exchange-token",
      "name": "Exchange Token"
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/oauth2/v2/userinfo?access_token={{ $json.access_token }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 500],
      "id": "get-user-info",
      "name": "Get User Info"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO users (email, jid, name) \nVALUES ('{{ $json.email }}', '{{ $('OAuth Callback').item.json.query.state }}', '{{ $json.name }}') \nON CONFLICT (email) DO UPDATE SET jid = EXCLUDED.jid, name = EXCLUDED.name;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [800, 500],
      "id": "upsert-user",
      "name": "Upsert User JID",
      "credentials": {
        "postgres": {
          "id": "w8ulM5CTdc8r3obb",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger (Evolution)": {
      "main": [
        [
          {
            "node": "Prepare Auth Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Auth Link": {
      "main": [
        [
          {
            "node": "Send WA Auth Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OAuth Callback": {
      "main": [
        [
          {
            "node": "Exchange Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exchange Token": {
      "main": [
        [
          {
            "node": "Get User Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get User Info": {
      "main": [
        [
          {
            "node": "Upsert User JID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
